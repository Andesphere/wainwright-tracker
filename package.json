{
  "name": "wainwrightsbaggers",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.2.21",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@wainwrights/web --filter=@wainwrights/backend",
    "dev:web": "turbo run dev --filter=@wainwrights/web",
    "dev:backend": "turbo run dev --filter=@wainwrights/backend",
    "dev:mobile": "turbo run dev --filter=@wainwrights/mobile",
    "ios": "turbo run ios --filter=@wainwrights/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typecheck:strict": "turbo run typecheck:strict",
    "test": "bun run test:unit",
    "test:unit": "turbo run test:unit",
    "test:watch": "turbo run test:watch --parallel",
    "test:coverage": "turbo run test:coverage",
    "check": "turbo run check",
    "check:strict": "turbo run check:strict",
    "format": "turbo run format",
    "preflight": "bun run format && bun run check && bun run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "4.1.6",
    "globals": "^17.6.0",
    "jsdom": "27.3.0",
    "prettier": "^3.8.3",
    "turbo": "^2.6.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
