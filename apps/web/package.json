{
  "name": "@wainwrights/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "bun run test:unit",
    "test:unit": "node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.mts --project web-unit",
    "test:watch": "node ../../node_modules/vitest/vitest.mjs --config ../../vitest.config.mts --project web-unit",
    "test:coverage": "node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.mts --project web-unit --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "typecheck:strict": "tsc --noEmit -p tsconfig.json",
    "check": "bun run typecheck && bun run lint && bun run build",
    "check:strict": "bun run typecheck:strict && bun run lint && bun run build",
    "format": "prettier -w . --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "@fontsource-variable/geist": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.1.4",
    "@hugeicons/react": "^1.1.6",
    "@openandes/relay-sdk": "^0.2.1",
    "@types/geojson": "^7946.0.16",
    "@vercel/analytics": "^2.0.1",
    "@wainwrights/backend": "workspace:*",
    "@wainwrights/catalog": "workspace:*",
    "ai": "^6.0.184",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.39.1",
    "mammoth": "^1.12.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.0",
    "radix-ui": "^1.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^7.15.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "workbox-window": "^7.4.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.2"
  }
}
