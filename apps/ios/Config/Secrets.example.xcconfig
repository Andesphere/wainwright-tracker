// Copy to Secrets.xcconfig (gitignored) and fill in.
// Mapbox public token (pk.*) with the default public scopes.
MAPBOX_ACCESS_TOKEN = pk.your-mapbox-public-token
// Clerk publishable key of the production instance (pk_live_*, clerk.wainwrightsbaggers.com).
// Convex prod only accepts tokens from that instance.
CLERK_PUBLISHABLE_KEY = pk_live_your-clerk-key
// RevenueCat public Apple SDK key (appl_*) of the Wainwrights Baggers project.
REVENUECAT_API_KEY = appl_your-revenuecat-key
// Sentry DSN of the andy-partner/wainwrights-ios project. xcconfig reads // as a comment,
// so write the scheme as https:/$()/ to keep the URL whole.
SENTRY_DSN = https:/$()/your-key@o0.ingest.us.sentry.io/0
// PostHog project token (phc_*) of the wainwrights-baggers project. Public, like the keys above.
POSTHOG_PROJECT_TOKEN = phc_your-posthog-token
